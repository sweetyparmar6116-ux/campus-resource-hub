# Copy this file to .env for local development:   cp .env.example .env
# .env is ignored by git. NEVER commit real secrets.

# "development" (default) or "production". Production refuses to start
# without a real SECRET_KEY, ADMIN_EMAIL and ADMIN_PASSWORD.
APP_ENV=development

# Development: leave SECRET_KEY empty - a random key is created in instance/secret_key.
# Production: generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Administrator account, created only the FIRST time the database is created.
# If these are not set in development, the app uses admin@campushub.local with the
# development-only default password written in README.md.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password-here

# Optional: DATABASE_PATH=campushub.db
# Optional (production behind plain http only): COOKIE_SECURE=0
